{
  "id": "/",
  "name": "Hexplorers",
  "short_name": "Hexplorers",
  "description": "A free 3D board game: explore a living island, trade with a crew of computer players and build your way to ten points, in your browser.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
