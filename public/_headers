# Cloudflare static-asset headers (see wrangler.toml).
# Built files carry a hash of their content in the name: cache them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is checked each visit, so a release reaches everyone straight away.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/art/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/social/*
  Cache-Control: public, max-age=86400

# The service worker (public/sw.js) is checked at every launch, past any cache, so a change to it
# reaches everyone straight away. Its kill switch, /sw-off, is only there while it is switched off.
/sw.js
  Cache-Control: no-cache
/sw-off
  Cache-Control: no-store
